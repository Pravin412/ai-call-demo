# Get a free Gemini API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Live API model (check https://ai.google.dev/gemini-api/docs/live for current names)
GEMINI_LIVE_MODEL=gemini-2.0-flash-live-001

# Gemini text model for browser-speech fallback
GEMINI_TEXT_MODEL=gemini-2.0-flash

# Set to true to use browser Web Speech API + Gemini text model instead of Live API
USE_BROWSER_SPEECH=false

# Use Groq (free, fast) instead of Gemini for the text replies in browser-speech mode
# Get a key at https://console.groq.com/keys
USE_GROQ=false
GROQ_API_KEY=your_groq_api_key_here

# Backend port (the frontend calls http://localhost:3005)
PORT=3005
