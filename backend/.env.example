# Get a free Gemini API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Live API model (check https://ai.google.dev/gemini-api/docs/live for current names)
GEMINI_LIVE_MODEL=gemini-2.0-flash-live-001

# Gemini text model for browser-speech fallback
GEMINI_TEXT_MODEL=gemini-2.0-flash

# Set to true to use browser Web Speech API + Gemini text model instead of Live API
USE_BROWSER_SPEECH=false

# Use Groq (free, fast) instead of Gemini for the text replies in browser-speech mode
# Get a key at https://console.groq.com/keys
USE_GROQ=false
GROQ_API_KEY=your_groq_api_key_here

# Python voice AI service on Google Colab (Whisper + Llama 3.2 + XTTS-v2), served by /api/v1/voice-ai/*
# The ngrok URL changes every time the tunnel restarts; paste the current one here and restart the backend
VOICE_AI_BASE_URL=https://your-tunnel.ngrok-free.dev
# Sent as the X-API-Key header once the Python service checks it; leave empty until then
VOICE_AI_API_KEY=
# Authorised reference voice the AI replies in, used when a request has no voice_sample (keep it out of git)
VOICE_AI_VOICE_SAMPLE_PATH=C:/path/to/authorised-voice.wav

# Backend port (the frontend calls http://localhost:3005)
PORT=3005

# AI Platform (local Whisper + Qwen + Piper)
AI_PLATFORM_URL=http://127.0.0.1:8000
AI_PLATFORM_API_KEY=aip_your_api_key
AI_CALL_DEMO_CALLBACK_SECRET=same-value-as-in-the-ai-platform-env

# MCP server at /mcp. The AI Platform connects to it with AI_CALL_DEMO_CALLBACK_SECRET (signed requests).
# MCP_API_KEY also lets ChatGPT, Claude, Cursor and other MCP clients in; leave empty to keep them out.
# Clients send it as "Authorization: Bearer <key>". Make a long random one, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_API_KEY=
